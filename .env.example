# ==============================================================================
# devs APK Builder - Environment Configuration Template (.env.example)
# ==============================================================================

# 1. Database (Supabase / PostgreSQL)
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. Authentication & Admin Login
JWT_SECRET=your-random-32-character-secret-key-here
ADMIN_EMAIL=developer@apkbuilder.dev
ADMIN_PASSWORD=your_secure_password_here

# 3. APK Expiring Download Links (HMAC SHA-256)
DOWNLOAD_SIGNING_SECRET=your-download-signing-key-here

# 4. GitHub Actions Runner (Optional - Free Tier Cloud Builds)
# Generate token at https://github.com/settings/tokens with 'repo' and 'workflow' permissions
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=yourusername/apk-builder
GITHUB_BRANCH=main
